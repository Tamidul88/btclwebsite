###############################################################################
# Application
###############################################################################
APP_NAME="{{COMPANY}}"
APP_ENV=production
APP_KEY=
# MUST be false in production. With debug on, an error page leaks the stack,
# environment and any value passed through the failing frame.
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

COMPANY_NAME="{{COMPANY}}"
COMPANY_EMAIL=hello@example.com
COMPANY_PHONE="+44 20 7946 0100"

###############################################################################
# Admin panel
###############################################################################
# Non-default path. Change this before first deploy.
ADMIN_PATH=ctrl-a9f2

# Comma-separated IPs / CIDRs. Leave empty to disable.
# Example: ADMIN_IP_ALLOWLIST=203.0.113.4,198.51.100.0/24
ADMIN_IP_ALLOWLIST=

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
TWO_FACTOR_ENFORCE=true
TWO_FACTOR_WINDOW=1

###############################################################################
# Transport security
###############################################################################
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Leave false until every subdomain has been HTTPS-only for months. Preload
# is extremely hard to reverse.
HSTS_PRELOAD=false

# Set to true first, watch the reports, then switch to enforcing.
CSP_REPORT_ONLY=false
CSP_REPORT_URI=

# Proxy ranges only — NEVER '*'. A wildcard lets any client spoof
# X-Forwarded-For and defeat both rate limiting and the IP allowlist.
# Cloudflare ranges: https://www.cloudflare.com/ips/
TRUSTED_PROXIES=

###############################################################################
# Session & cookies
###############################################################################
SESSION_DRIVER=database
# Short by design: the panel handles enquiry data.
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_DOMAIN=

###############################################################################
# Database — MySQL 8, bound to localhost, least privilege
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=consulting
DB_USERNAME=consulting_app
DB_PASSWORD=

###############################################################################
# Cache / queue
###############################################################################
CACHE_STORE=database
QUEUE_CONNECTION=database

###############################################################################
# Uploads
###############################################################################
UPLOAD_MAX_KB=5120

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=daily,security
LOG_LEVEL=warning

###############################################################################
# Monitoring
###############################################################################
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Scrubs request bodies and PII before anything leaves the server.
SENTRY_SEND_DEFAULT_PII=false

###############################################################################
# Social
###############################################################################
SOCIAL_LINKEDIN=https://www.linkedin.com/
SOCIAL_GITHUB=https://github.com/
